# Application runtime settings (copy to .env for local overrides; never commit .env)
APP_ENV=development
APP_NAME=Local AI Engineering Agent
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave blank to default to <repo>/workspaces (relative paths resolve against repo root)
WORKSPACES_DIR=

# External optional tool overrides (leave blank to auto-detect on PATH / default locations)
TESSERACT_CMD=
ODA_FILE_CONVERTER_PATH=

# API keys (e.g. Gemini) live in Windows Credential Manager via keyring (Step 04), never in .env or git.
